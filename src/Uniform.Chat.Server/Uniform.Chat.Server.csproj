<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The program is uniform-chat-server, as the service and its folders are named -->
    <AssemblyName>uniform-chat-server</AssemblyName>
    <RootNamespace>Uniform.Chat.Server</RootNamespace>
    <!-- Code comments are for developers: no .xml documentation files in the published app -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <!-- Package -->
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Uniform.Matrix.Server\Uniform.Matrix.Server.csproj" />
    <ProjectReference Include="..\Uniform.Matrix.Gui.Terminal\Uniform.Matrix.Gui.Terminal.csproj" />
  </ItemGroup>

</Project>
