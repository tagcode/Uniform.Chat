<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Uniform.Chat.Avalonia\Assets\icon.ico</ApplicationIcon>
    <!-- The program is Uniform.Chat: file managers take a name ending in .Desktop for a .desktop launcher, and do not run it -->
    <AssemblyName>Uniform.Chat</AssemblyName>
    <RootNamespace>Uniform.Chat.Desktop</RootNamespace>
    <!-- Code comments are for developers: no .xml documentation files in the published app -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <!-- Package -->
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <!-- Linux notifications over D-Bus; the same version Avalonia uses -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
  </ItemGroup>

  <!-- Linux: an application menu entry, installed by the user from the unpacked folder -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <None Include="Linux\install-desktop-entry.sh" CopyToPublishDirectory="PreserveNewest" Link="install-desktop-entry.sh" />
    <None Include="..\Uniform.Chat.Avalonia\Assets\icon.png" CopyToPublishDirectory="PreserveNewest" Link="uniform-chat.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Uniform.Chat.Avalonia\Uniform.Chat.Avalonia.csproj" />
  </ItemGroup>

</Project>
