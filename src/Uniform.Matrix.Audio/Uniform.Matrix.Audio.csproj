<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Package -->
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tagcode/Uniform.Matrix</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tagcode/Uniform.Matrix</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Voice audio for Matrix calls: Opus encoding and decoding, 20 ms voice frames from a microphone and to a speaker over NAudio, with ALSA on Linux and WASAPI on Windows.</Description>
    <PackageTags>matrix;audio;opus;voice;calls;naudio</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Readme shown on nuget.org -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="NAudio.Core" Version="3.3.0" />
    <PackageReference Include="NAudio.Alsa" Version="3.3.0" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Uniform.Matrix.Audio.Tests" />
  </ItemGroup>

</Project>
