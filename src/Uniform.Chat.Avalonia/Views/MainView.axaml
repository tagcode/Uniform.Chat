<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Uniform.Chat.Avalonia.ViewModels"
             xmlns:views="using:Uniform.Chat.Avalonia.Views"
             x:Class="Uniform.Chat.Avalonia.Views.MainView"
             x:DataType="vm:MainViewModel"
             FontSize="{Binding Settings.TextSize}">
  <!-- One view per page -->
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:LoginViewModel"><views:LoginView /></DataTemplate>
    <DataTemplate DataType="vm:ConnectingViewModel"><views:ConnectingView /></DataTemplate>
    <DataTemplate DataType="vm:ChatViewModel"><views:ChatView /></DataTemplate>
  </UserControl.DataTemplates>
  <ContentControl x:Name="PageHost" Content="{Binding Page}" />
</UserControl>
