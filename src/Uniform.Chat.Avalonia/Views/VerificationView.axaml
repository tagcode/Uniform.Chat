<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Uniform.Chat.Avalonia.ViewModels"
             xmlns:crypto="using:Uniform.Matrix.Protocol.Crypto"
             x:Class="Uniform.Chat.Avalonia.Views.VerificationView"
             x:DataType="vm:VerificationViewModel">
  <StackPanel Spacing="12">
    <TextBlock Classes="title" Text="Verify device" />
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />

    <!-- Emoji to compare, as on the other device -->
    <ItemsControl ItemsSource="{Binding Emoji}" IsVisible="{Binding IsComparing}" HorizontalAlignment="Center" MaxWidth="330">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="crypto:SasEmoji">
          <StackPanel Width="78" Margin="2,4" Spacing="2">
            <TextBlock Text="{Binding Symbol}" FontSize="34" HorizontalAlignment="Center" />
            <TextBlock Classes="hint" Text="{Binding Name}" HorizontalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Classes="hint" HorizontalAlignment="Center" Text="{Binding Numbers, StringFormat='or the numbers {0}'}" IsVisible="{Binding IsComparing}" />

    <!-- Answers by state -->
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Classes="accent" Content="Accept" Command="{Binding AcceptCommand}" IsVisible="{Binding IsIncoming}" />
      <Button Classes="accent" Content="They match" Command="{Binding MatchCommand}" IsVisible="{Binding IsComparing}" />
      <Button Content="They don't match" Command="{Binding MismatchCommand}" IsVisible="{Binding IsComparing}" />
      <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding !IsFinished}" />
      <Button Classes="accent" Content="Close" Command="{Binding CloseCommand}" IsVisible="{Binding IsFinished}" />
    </StackPanel>
  </StackPanel>
</UserControl>
