<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Uniform.Chat.Avalonia.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Uniform.Chat.Avalonia.ViewModels"
             xmlns:crypto="using:Uniform.Matrix.Protocol.Crypto"
             x:Class="Uniform.Chat.Avalonia.Views.VerificationView"
             x:DataType="vm:VerificationViewModel">
  <StackPanel Spacing="12">
    <TextBlock Classes="title" Text="{l:Tr VerifyDevice}" />
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />

    <!-- Emoji to compare, as on the other device -->
    <ItemsControl ItemsSource="{Binding Emoji}" IsVisible="{Binding IsComparing}" HorizontalAlignment="Center" MaxWidth="330">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="crypto:SasEmoji">
          <StackPanel Width="78" Margin="2,4" Spacing="2">
            <TextBlock Text="{Binding Symbol}" FontSize="34" HorizontalAlignment="Center" />
            <TextBlock Classes="hint" Text="{Binding Name}" HorizontalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Classes="hint" HorizontalAlignment="Center" Text="{Binding NumbersText}" IsVisible="{Binding IsComparing}" />

    <!-- Answers by state -->
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Classes="accent" Content="{l:Tr Accept}" Command="{Binding AcceptCommand}" IsVisible="{Binding IsIncoming}" />
      <Button Classes="accent" Content="{l:Tr TheyMatch}" Command="{Binding MatchCommand}" IsVisible="{Binding IsComparing}" />
      <Button Content="{l:Tr TheyDontMatch}" Command="{Binding MismatchCommand}" IsVisible="{Binding IsComparing}" />
      <Button Content="{l:Tr Cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding !IsFinished}" />
      <Button Classes="accent" Content="{l:Tr Close}" Command="{Binding CloseCommand}" IsVisible="{Binding IsFinished}" />
    </StackPanel>
  </StackPanel>
</UserControl>
