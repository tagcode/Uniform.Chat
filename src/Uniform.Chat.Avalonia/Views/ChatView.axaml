<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Uniform.Chat.Avalonia.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Uniform.Chat.Avalonia.ViewModels"
             xmlns:views="using:Uniform.Chat.Avalonia.Views"
             x:Class="Uniform.Chat.Avalonia.Views.ChatView"
             x:DataType="vm:ChatViewModel"
             Classes.narrow="{Binding IsNarrow}">
  <UserControl.Resources>
    <views:SenderColorConverter x:Key="SenderColor" />
  </UserControl.Resources>

  <!-- Narrow screens show one pane across the whole width; sizes are styles, as a local value would win over them -->
  <UserControl.Styles>
    <Style Selector="Border#RoomPanel">
      <Setter Property="Width" Value="300" />
    </Style>
    <Style Selector=".narrow Border#RoomPanel">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="WrapPanel#CallButtons">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector=".narrow WrapPanel#CallButtons">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="-4,6,0,0" />
    </Style>
    <Style Selector=".narrow DockPanel#RoomArea">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
  </UserControl.Styles>

  <DockPanel Classes.videocall="{Binding Call.ShowsFullScreen, FallbackValue=False}">

  <!-- Call bar, above everything, so an incoming call shows whatever is open -->
  <Border DockPanel.Dock="Top" Classes="call" DataContext="{Binding Call}" IsVisible="{Binding IsVisible, FallbackValue=False}" x:DataType="vm:CallViewModel">
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock Classes="title" Text="{Binding PeerName}" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding StateText}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <WrapPanel x:Name="CallButtons" VerticalAlignment="Center">
        <Button Classes="accent" Margin="4,2" Content="{l:Tr Answer}" Command="{Binding AnswerCommand}" IsVisible="{Binding IsRinging}" />
        <Button Classes="accent" Margin="4,2" Content="{l:Tr AnswerWithVideo}" Command="{Binding AnswerWithVideoCommand}" IsVisible="{Binding CanAnswerWithVideo}" />
        <Button Margin="4,2" Content="{l:Tr Decline}" Command="{Binding RejectCommand}" IsVisible="{Binding IsRinging}" />
        <Button Margin="4,2" Content="{Binding MuteText}" Command="{Binding ToggleMuteCommand}" IsVisible="{Binding IsActive}" />
        <!-- Device menus: the cameras with turning the camera off, then the microphones and speakers, each filled as it opens -->
        <Button Margin="4,2" Content="{l:Tr CameraMenu}" Classes.warning="{Binding CameraOff}" IsVisible="{Binding SendsVideo}">
          <Button.Flyout>
            <MenuFlyout ItemsSource="{Binding CameraMenu}" Opening="OnDeviceMenuOpening">
              <MenuFlyout.ItemContainerTheme>
                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:DeviceMenuItem">
                  <Setter Property="Header" Value="{Binding Label}" />
                  <Setter Property="Command" Value="{Binding Command}" />
                </ControlTheme>
              </MenuFlyout.ItemContainerTheme>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button Margin="4,2" Content="{l:Tr MicrophoneMenu}" IsVisible="{Binding IsActive}">
          <Button.Flyout>
            <MenuFlyout ItemsSource="{Binding MicrophoneMenu}" Opening="OnDeviceMenuOpening">
              <MenuFlyout.ItemContainerTheme>
                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:DeviceMenuItem">
                  <Setter Property="Header" Value="{Binding Label}" />
                  <Setter Property="Command" Value="{Binding Command}" />
                </ControlTheme>
              </MenuFlyout.ItemContainerTheme>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button Margin="4,2" Content="{l:Tr SpeakerMenu}" IsVisible="{Binding IsActive}">
          <Button.Flyout>
            <MenuFlyout ItemsSource="{Binding SpeakerMenu}" Opening="OnDeviceMenuOpening">
              <MenuFlyout.ItemContainerTheme>
                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:DeviceMenuItem">
                  <Setter Property="Header" Value="{Binding Label}" />
                  <Setter Property="Command" Value="{Binding Command}" />
                </ControlTheme>
              </MenuFlyout.ItemContainerTheme>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button Margin="4,2" Content="{Binding ScreenText}" Command="{Binding ToggleScreenCommand}" IsVisible="{Binding ShowsVideo}" />
        <Button Classes="danger" Margin="4,2" Content="{l:Tr HangUp}" Command="{Binding HangupCommand}" IsVisible="{Binding IsActive}" />
      </WrapPanel>
      <Panel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0" HorizontalAlignment="Center">
        <views:VideoView x:Name="CallVideo" MaxHeight="260" Feed="{Binding MainVideo}" IsVisible="{Binding ShowsVideo}" />
        <!-- Own camera in the corner, or a clear sign that it is off -->
        <views:VideoView Width="96" MaxHeight="128" Margin="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Feed="{Binding LocalVideo}" IsVisible="{Binding ShowsCornerPreview}" />
        <Border Classes="cameraoff" Margin="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="{Binding CameraOff}">
          <TextBlock Text="{l:Tr CameraIsOff}" />
        </Border>
      </Panel>
      <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Classes="hint" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </Grid>
  </Border>

  <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding !Call.ShowsFullScreen, FallbackValue=True}">

    <!-- Rooms -->
    <Border x:Name="RoomPanel" Grid.Column="0" Classes="sidebar" IsVisible="{Binding ShowRoomList}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="12,10">
          <Image Grid.Column="0" Source="avares://Uniform.Chat.Avalonia/Assets/logo.png" Width="28" Height="28" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
            <TextBlock Classes="title" Text="Uniform Chat" />
            <TextBlock Classes="hint" Text="{Binding UserId}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="2" Classes="icon" Content="⋮" ToolTip.Tip="{l:Tr Account}">
            <Button.Flyout>
              <!-- A menu flyout closes when an item is chosen, unlike buttons in a plain flyout -->
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="{l:Tr RoomDirectoryEllipsis}" Command="{Binding OpenDirectoryCommand}" />
                <MenuItem Header="{l:Tr SecurityAndRecovery}" Command="{Binding OpenSecurityCommand}" />
                <MenuItem Header="{l:Tr ServerAdministrationEllipsis}" Command="{Binding OpenAdminCommand}" IsVisible="{Binding IsServerAdmin}" />
                <MenuItem Header="{l:Tr SettingsEllipsis}" Command="{Binding ToggleSettingsCommand}" IsVisible="{Binding Settings, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Separator />
                <MenuItem Header="{l:Tr SignOut}" Command="{Binding SignOutCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="12,0,12,8">
          <TextBox Grid.Column="0" Text="{Binding JoinTarget}" PlaceholderText="{l:Tr RoomBoxPlaceholder}" ToolTip.Tip="{l:Tr RoomBoxHint}" x:Name="RoomBox" />
          <Button Grid.Column="1" Margin="6,0,0,0" Content="{Binding OpenTargetText}" Command="{Binding OpenTargetCommand}" />
          <Button Grid.Column="2" Margin="6,0,0,0" Classes="icon" Content="🔍" ToolTip.Tip="{l:Tr RoomDirectory}" Command="{Binding OpenDirectoryCommand}" />
        </Grid>

        <!-- Content shared from another app waits for a room -->
        <Border DockPanel.Dock="Top" Classes="notice" Margin="12,0,12,8" IsVisible="{Binding HasPendingShare}">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding PendingShareText}" TextWrapping="Wrap" />
            <Button Content="{l:Tr Cancel}" Command="{Binding CancelShareCommand}" />
          </StackPanel>
        </Border>

        <!-- Set up recovery, or verify this device, until done or dismissed -->
        <Border DockPanel.Dock="Top" Classes="notice" Margin="12,0,12,8" IsVisible="{Binding HasSecuritySuggestion}">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding SecuritySuggestion}" TextWrapping="Wrap" />
            <!-- Wraps when large text makes the buttons wider than the sidebar -->
            <WrapPanel ItemSpacing="8" LineSpacing="6">
              <Button Classes="accent" Content="{l:Tr SecurityAndRecovery}" Command="{Binding OpenSecurityCommand}" />
              <Button Content="{l:Tr NotNow}" Command="{Binding DismissSecuritySuggestionCommand}" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Classes="status" Text="{Binding StatusText}" IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />

        <ListBox x:Name="RoomList" ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" Classes="rooms" ContextRequested="OnRoomContextRequested">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RoomItemViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                <Border Grid.Column="0" Classes="avatar" Background="{Binding RoomId, Converter={StaticResource SenderColor}}">
                  <Panel>
                    <TextBlock Text="{Binding Initial}" IsVisible="{Binding !HasAvatar}" />
                    <Image Source="{Binding Avatar}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                  <!-- The name, then the topic dimmed after it; the name keeps its room, the topic is cut first -->
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Classes.unread="{Binding HasUnread}" MaxWidth="{Binding $parent[Grid].Bounds.Width}" />
                    <TextBlock Grid.Column="1" Classes="hint" Text="{Binding TopicLine, StringFormat='  {0}'}" TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center" IsVisible="{Binding HasTopic}" />
                  </Grid>
                  <TextBlock Classes="hint" Text="{l:Tr Invitation}" IsVisible="{Binding IsInvite}" />
                  <TextBlock Classes="hint" Text="{l:Tr FromYourServer}" IsVisible="{Binding IsServerNotice}" />
                  <TextBlock Classes="hint" Text="{Binding LastMessage}" TextTrimming="CharacterEllipsis" MaxLines="1" IsVisible="{Binding HasLastMessage}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4">
                  <TextBlock Classes="hint" Text="{Binding LastTime}" HorizontalAlignment="Right" />
                  <Border Classes="badge" Classes.mention="{Binding IsHighlighted}" IsVisible="{Binding HasUnread}" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding UnreadText}" />
                  </Border>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Open room -->
    <DockPanel x:Name="RoomArea" Grid.Column="1" IsVisible="{Binding ShowRoom}" DragDrop.AllowDrop="True">
      <Border DockPanel.Dock="Top" Classes="header">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Grid.Column="0" Classes="icon" Content="‹" Command="{Binding BackCommand}" IsVisible="{Binding IsNarrow}" ToolTip.Tip="{l:Tr Rooms}" />
          <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
            <TextBlock Classes="title" Text="{Binding SelectedRoom.Name, FallbackValue='Choose a room'}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="hint" Text="{Binding SelectedRoom.Topic, FallbackValue=''}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
            <TextBlock Classes="hint" VerticalAlignment="Center" Text="{l:Tr EncryptedBadge}" IsVisible="{Binding SelectedRoom.IsEncrypted, FallbackValue=False}" />
            <Button Classes="icon" Content="📹" ToolTip.Tip="{l:Tr VideoCall}" Command="{Binding VideoCallRoomCommand}" IsVisible="{Binding CanVideoCallRoom}" />
            <Button Classes="icon" Content="📞" ToolTip.Tip="{l:Tr VoiceCall}" Command="{Binding CallRoomCommand}" IsVisible="{Binding CanCallRoom}" />
            <Button Classes="icon" Content="⋮" ToolTip.Tip="{l:Tr Room}" Command="{Binding LoadMembersCommand}" IsVisible="{Binding !SelectedRoom.IsInvite, FallbackValue=False}">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <StackPanel Width="320" Spacing="8">
                    <TextBlock Classes="subtitle" Text="{l:Tr Topic}" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBox Grid.Column="0" Text="{Binding TopicDraft}" PlaceholderText="{l:Tr WhatTheRoomIsAbout}" />
                      <Button Grid.Column="1" Margin="6,0,0,0" Content="{l:Tr Set}" Command="{Binding SetTopicCommand}" />
                    </Grid>
                    <TextBlock Classes="subtitle" Text="{l:Tr Invite}" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBox Grid.Column="0" Text="{Binding InviteTarget}" PlaceholderText="@user:server" />
                      <Button Grid.Column="1" Margin="6,0,0,0" Content="{l:Tr Invite}" Command="{Binding InviteCommand}" />
                    </Grid>
                    <TextBlock Classes="subtitle" Text="{l:Tr Members}" />
                    <ScrollViewer MaxHeight="240">
                      <ItemsControl ItemsSource="{Binding Members}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:MemberItem">
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                              <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="hint" Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <Button Grid.Column="1" Classes="link" Margin="8,0,0,0" Content="{l:Tr Verify}" Click="OnVerifyMemberClick" IsVisible="{Binding ShowVerify}" />
                              <Button Grid.Column="2" Classes="link" Margin="8,0,0,0" Content="{Binding BlockText}" Click="OnBlockMemberClick" IsVisible="{Binding !IsOwn}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <Separator />
                    <Button Content="{l:Tr ReportRoom}" Click="OnReportRoomClick" HorizontalAlignment="Stretch" />
                    <Button Content="{l:Tr LeaveRoom}" Command="{Binding LeaveRoomCommand}" HorizontalAlignment="Stretch" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Invitation -->
      <Border DockPanel.Dock="Top" Classes="banner" IsVisible="{Binding SelectedRoom.IsInvite, FallbackValue=False}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock VerticalAlignment="Center" Text="{l:Tr InvitedToRoom}" />
          <Button Classes="accent" Content="{l:Tr Join}" Command="{Binding AcceptInviteCommand}" />
          <Button Content="{l:Tr Decline}" Command="{Binding DeclineInviteCommand}" />
        </StackPanel>
      </Border>

      <!-- Server notices, which only the server writes -->
      <Border DockPanel.Dock="Top" Classes="banner" IsVisible="{Binding SelectedRoom.IsServerNotice, FallbackValue=False}">
        <TextBlock TextWrapping="Wrap" Text="{l:Tr ServerNoticesHint}" />
      </Border>

      <!-- Suspended account -->
      <Border DockPanel.Dock="Top" Classes="notice" IsVisible="{Binding IsSuspended}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" TextWrapping="Wrap" VerticalAlignment="Center" Text="{l:Tr AccountSuspendedHint}" />
          <Button Grid.Column="1" Classes="icon" Content="✕" ToolTip.Tip="{l:Tr HideAndTryAgain}" Command="{Binding DismissSuspensionCommand}" />
        </Grid>
      </Border>

      <!-- Errors and results -->
      <Border DockPanel.Dock="Top" Classes="notice" IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="icon" Content="✕" Command="{Binding DismissNoticeCommand}" />
        </Grid>
      </Border>

      <!-- Message box -->
      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="12,6,12,12" IsVisible="{Binding HasOpenRoom}">
        <Button Grid.Column="0" Margin="0,0,6,0" Content="📎" ToolTip.Tip="{l:Tr SendAFile}" Click="OnAttachClick" VerticalAlignment="Bottom" IsEnabled="{Binding CanCompose}" />
        <TextBox x:Name="ComposerBox" Grid.Column="1" Text="{Binding Composer}" PlaceholderText="{l:Tr MessagePlaceholder}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160" IsEnabled="{Binding CanCompose}" />
        <Button Grid.Column="2" Margin="6,0,0,0" Classes="accent" Content="{l:Tr Send}" Command="{Binding SendCommand}" Focusable="False" ToolTip.Tip="{l:Tr SendTip}" VerticalAlignment="Bottom" />
      </Grid>
      <Border DockPanel.Dock="Bottom" Classes="compose" IsVisible="{Binding HasSharedFiles}">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Grid.Column="0" Text="{Binding SharedFilesText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="accent" Margin="6,0,0,0" Content="{l:Tr Send}" Command="{Binding SendSharedFilesCommand}" />
          <Button Grid.Column="2" Margin="6,0,0,0" Content="{l:Tr Cancel}" Command="{Binding CancelShareCommand}" />
        </Grid>
      </Border>
      <Border DockPanel.Dock="Bottom" Classes="compose" IsVisible="{Binding IsComposingSpecial}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding ComposeMode}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="icon" Content="✕" ToolTip.Tip="{l:Tr CancelEsc}" Command="{Binding CancelComposeCommand}" />
        </Grid>
      </Border>
      <TextBlock DockPanel.Dock="Bottom" Classes="typing" Text="{Binding TypingText}" IsVisible="{Binding TypingText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <!-- Messages -->
      <Panel>
        <TextBlock Classes="hint" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{l:Tr ChooseRoomToStart}" IsVisible="{Binding !HasOpenRoom}" />
        <ListBox x:Name="MessageList" ItemsSource="{Binding Messages.Items}" Classes="messages" IsVisible="{Binding HasOpenRoom}" ContextRequested="OnMessageContextRequested">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MessageViewModel">
              <DockPanel>
                <!-- First message of a day -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,*" Margin="0,10,0,4" IsVisible="{Binding HasDay}">
                  <Separator Grid.Column="0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="hint" Margin="10,0" Text="{Binding Day}" />
                  <Separator Grid.Column="2" VerticalAlignment="Center" />
                </Grid>
                <Panel>
                  <!-- Membership and state changes -->
                  <TextBlock Classes="info" IsVisible="{Binding IsInfo}" TextWrapping="Wrap">
                    <Run Text="{Binding Text}" />
                    <Run Classes="time" Text="{Binding TimeText}" />
                  </TextBlock>

                  <!-- Messages, the sender's avatar beside the first of a group -->
                  <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding !IsInfo}">
                  <Panel Grid.Column="0" Width="32" Margin="0,8,10,0" VerticalAlignment="Top">
                    <Border Classes="avatar small" Background="{Binding SenderId, Converter={StaticResource SenderColor}}" IsVisible="{Binding ShowHeader}">
                      <Panel>
                        <TextBlock Text="{Binding SenderInitial}" IsVisible="{Binding !HasSenderAvatar}" />
                        <Image Source="{Binding SenderAvatar}" Stretch="UniformToFill" IsVisible="{Binding HasSenderAvatar}" />
                      </Panel>
                    </Border>
                  </Panel>
                  <StackPanel Grid.Column="1" Spacing="2" Margin="0,2">
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowHeader}" Margin="0,6,0,0">
                      <TextBlock Classes="sender" Text="{Binding SenderName}" Foreground="{Binding SenderId, Converter={StaticResource SenderColor}}" />
                      <TextBlock Classes="time" Text="{Binding TimeText}" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <Border Classes="quote" IsVisible="{Binding ReplyQuote, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <TextBlock Text="{Binding ReplyQuote}" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <!-- No menu of its own, so that a long press or right-click reaches the message's actions, which copy the text too -->
                    <views:RichText Body="{Binding Text}" Html="{Binding Html}" TextWrapping="Wrap" Classes.highlight="{Binding IsHighlight}" Classes.pending="{Binding IsPending}" ContextFlyout="{x:Null}" />
                    <Image Source="{Binding Thumbnail}" MaxHeight="320" MaxWidth="480" HorizontalAlignment="Left" Stretch="Uniform" Cursor="Hand" ToolTip.Tip="{l:Tr Open}" Tapped="OnImageTapped" IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="link" Content="{l:Tr Open}" Click="OnOpenClick" IsVisible="{Binding IsAttachment}" />
                      <Button Classes="link" Content="{l:Tr SaveEllipsis}" Click="OnSaveClick" IsVisible="{Binding IsAttachment}" />
                      <TextBlock Classes="hint" Text="{l:Tr Edited}" IsVisible="{Binding IsEdited}" />
                      <TextBlock Classes="hint" Text="{Binding SendState}" IsVisible="{Binding IsPending}" />
                      <Border Classes="reactions" IsVisible="{Binding HasReactions}">
                        <TextBlock Text="{Binding Reactions}" />
                      </Border>
                    </StackPanel>
                  </StackPanel>
                  </Grid>
                </Panel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" IsVisible="{Binding IsLoadingHistory}" />
      </Panel>
    </DockPanel>

    <!-- Settings over everything -->
    <Border Grid.ColumnSpan="2" Classes="overlay" IsVisible="{Binding IsSettingsOpen}">
      <Border Classes="card">
        <Grid RowDefinitions="Auto,*">
          <Button Grid.Row="0" Classes="icon" Content="✕" ToolTip.Tip="{l:Tr Close}" Command="{Binding ToggleSettingsCommand}" HorizontalAlignment="Right" />
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <views:SettingsView DataContext="{Binding Settings}" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Border>

    <!-- Room directory over everything -->
    <Border Grid.ColumnSpan="2" Classes="overlay" IsVisible="{Binding RoomDirectory, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Classes="card tall">
        <Grid RowDefinitions="Auto,*">
          <Button Grid.Row="0" Classes="icon" Content="✕" ToolTip.Tip="{l:Tr Close}" Command="{Binding CloseDirectoryCommand}" HorizontalAlignment="Right" />
          <views:DirectoryView Grid.Row="1" DataContext="{Binding RoomDirectory}" />
        </Grid>
      </Border>
    </Border>

    <!-- Security panel over everything -->
    <Border Grid.ColumnSpan="2" Classes="overlay" IsVisible="{Binding Security, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Classes="card">
        <Grid RowDefinitions="Auto,*">
          <Button Grid.Row="0" Classes="icon" Content="✕" ToolTip.Tip="{l:Tr Close}" Command="{Binding CloseSecurityCommand}" HorizontalAlignment="Right" />
          <ScrollViewer Grid.Row="1">
            <views:SecurityView DataContext="{Binding Security}" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Border>

    <!-- Server administration panel over everything -->
    <Border Grid.ColumnSpan="2" Classes="overlay" IsVisible="{Binding Admin, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Classes="card">
        <Grid RowDefinitions="Auto,*">
          <Button Grid.Row="0" Classes="icon" Content="✕" ToolTip.Tip="{l:Tr Close}" Command="{Binding CloseAdminCommand}" HorizontalAlignment="Right" />
          <ScrollViewer Grid.Row="1">
            <views:AdminView DataContext="{Binding Admin}" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Border>

    <!-- Details and actions of a message or room, from the bottom; a tap beside the sheet closes it -->
    <Border x:Name="SheetOverlay" Grid.ColumnSpan="2" Classes="overlay" IsVisible="{Binding ActionSheet, Converter={x:Static ObjectConverters.IsNotNull}}" PointerPressed="OnSheetOverlayPressed">
      <Border Classes="sheet">
        <views:ActionSheetView DataContext="{Binding ActionSheet}" />
      </Border>
    </Border>

    <!-- Verification over everything, also over the security panel -->
    <Border Grid.ColumnSpan="2" Classes="overlay" IsVisible="{Binding Verification, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Classes="card">
        <views:VerificationView DataContext="{Binding Verification}" />
      </Border>
    </Border>
  </Grid>
  </DockPanel>
</UserControl>
