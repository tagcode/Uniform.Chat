<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Uniform.Chat.Avalonia.ViewModels"
             x:Class="Uniform.Chat.Avalonia.Views.SettingsView"
             xmlns:views="using:Uniform.Chat.Avalonia.Views"
             x:DataType="vm:SettingsViewModel">
  <Panel>
  <StackPanel Spacing="12" IsVisible="{Binding ShowsSettings}">
    <TextBlock Classes="title" Text="Settings" />

    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Theme" VerticalAlignment="Center" />
      <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Themes}" SelectedIndex="{Binding ThemeIndex}" HorizontalAlignment="Stretch" />

      <TextBlock Grid.Row="1" Grid.Column="0" Text="Text size" VerticalAlignment="Center" />
      <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="{Binding TextSizeIndex}" HorizontalAlignment="Stretch">
        <ComboBoxItem Content="Small" />
        <ComboBoxItem Content="Normal" />
        <ComboBoxItem Content="Large" />
      </ComboBox>

      <TextBlock Grid.Row="2" Grid.Column="0" Text="Notifications" VerticalAlignment="Center" IsVisible="{Binding CanNotify}" />
      <ToggleSwitch Grid.Row="2" Grid.Column="1" IsChecked="{Binding Notifications}" IsVisible="{Binding CanNotify}" OnContent="Direct messages, mentions, invites" OffContent="Off" />
    </Grid>

    <TextBlock Classes="hint" TextWrapping="Wrap" Text="Changes are saved right away." />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Test audio…" Command="{Binding ShowAudioTestCommand}" IsVisible="{Binding CanTestAudio}" />
      <Button Content="Licences…" Command="{Binding ShowLicensesCommand}" />
    </StackPanel>
  </StackPanel>

  <!-- Audio test in place of the settings -->
  <StackPanel Spacing="12" IsVisible="{Binding AudioTest, Converter={x:Static ObjectConverters.IsNotNull}}">
    <Grid ColumnDefinitions="Auto,*">
      <Button Grid.Column="0" Classes="icon" Content="‹" ToolTip.Tip="Settings" Command="{Binding CloseAudioTestCommand}" />
      <TextBlock Grid.Column="1" Classes="title" Text="Audio test" VerticalAlignment="Center" Margin="6,0,0,0" />
    </Grid>
    <StackPanel Spacing="12" DataContext="{Binding AudioTest}" x:DataType="vm:AudioTestViewModel">
      <ToggleSwitch IsChecked="{Binding Loudspeaker}" IsVisible="{Binding HasEarpiece}" IsEnabled="{Binding !IsRunning}" OnContent="Loudspeaker" OffContent="Earpiece" />
      <Button Classes="accent" Content="{Binding ButtonText}" Command="{Binding ToggleCommand}" HorizontalAlignment="Left" MinWidth="100" HorizontalContentAlignment="Center" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
    </StackPanel>
  </StackPanel>

  <!-- Licences in place of the settings -->
  <StackPanel Spacing="10" IsVisible="{Binding Licenses, Converter={x:Static ObjectConverters.IsNotNull}}">
    <Grid ColumnDefinitions="Auto,*">
      <Button Grid.Column="0" Classes="icon" Content="‹" ToolTip.Tip="Settings" Command="{Binding CloseLicensesCommand}" />
      <TextBlock Grid.Column="1" Classes="title" Text="Licences" VerticalAlignment="Center" Margin="6,0,0,0" />
    </Grid>
    <views:LicensesView DataContext="{Binding Licenses}" />
  </StackPanel>
  </Panel>
</UserControl>
