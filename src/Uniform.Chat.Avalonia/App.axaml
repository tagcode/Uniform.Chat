<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Uniform.Matrix.Client.Avalonia.Core.App"
             RequestedThemeVariant="Default">
  <!-- Follow the system's light or dark theme -->
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Uniform.Matrix.Client.Avalonia.Core/Views/Styles.axaml" />
  </Application.Styles>
</Application>
