<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Package -->
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tagcode/Uniform.Chat</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tagcode/Uniform.Chat</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>A WebRTC subset in pure C# for calls: SDP, ICE, DTLS-SRTP and RTP, Opus audio both ways and VP8 video received with RTCP feedback, with STUN and TURN from Uniform.Stun and BouncyCastle for DTLS.</Description>
    <PackageTags>webrtc;stun;turn;ice;dtls;srtp;rtp;sdp;voip</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Readme shown on nuget.org -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Uniform.Stun\Uniform.Stun.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Uniform.Matrix.WebRtc.Tests" />
  </ItemGroup>

</Project>

