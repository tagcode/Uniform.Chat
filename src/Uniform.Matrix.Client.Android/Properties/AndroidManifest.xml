<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:installLocation="auto">
  <!-- Matrix servers are reached over the network -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Voice: the microphone, and switching call audio to the loudspeaker -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
  <!-- Calls go on in the background: a foreground service of the microphone type -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <!-- Notifications of messages, incoming calls and the ongoing call -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <application android:label="Uniform.Matrix" android:icon="@drawable/icon" android:allowBackup="false" android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
