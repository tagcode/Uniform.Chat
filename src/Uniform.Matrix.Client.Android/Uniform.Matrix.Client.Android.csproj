<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ApplicationId>io.github.tagcode.uniform.matrix</ApplicationId>
    <ApplicationTitle>Uniform.Matrix</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- EF Core and the JSON records use reflection, so the code is not trimmed; ahead-of-time compilation needs trimming, so it is off too. A try with profiled ahead-of-time compilation and partial trimming started only about 10% faster on an old phone, and the trimmed build could no longer reach the server -->
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <!-- Marshal methods leave out the native methods of Java overrides in classes with a generic base, such as Avalonia's AvaloniaAndroidApplication<TApp>, so release builds crash at start with UnsatisfiedLinkError; methods are registered at run time instead, as in debug builds -->
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
  </PropertyGroup>

  <!-- Package -->
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.4" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Uniform.Matrix.Client.Avalonia.Core\Uniform.Matrix.Client.Avalonia.Core.csproj" />
  </ItemGroup>

</Project>
