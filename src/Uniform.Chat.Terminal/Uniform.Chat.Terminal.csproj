<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Uniform.Matrix.Audio\Uniform.Matrix.Audio.csproj" />
    <ProjectReference Include="..\Uniform.Matrix.Calls\Uniform.Matrix.Calls.csproj" />
    <ProjectReference Include="..\Uniform.Matrix.Client\Uniform.Matrix.Client.csproj" />
    <ProjectReference Include="..\Uniform.Matrix.Gui.Terminal\Uniform.Matrix.Gui.Terminal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <PackageReference Include="Terminal.Gui" Version="2.5.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The program is Uniform.Chat, as the desktop app's; Program keeps the application name, and with it the settings and data folders -->
    <AssemblyName>Uniform.Chat</AssemblyName>
    <RootNamespace>Uniform.Chat.Terminal</RootNamespace>
    <!-- Code comments are for developers: no .xml documentation files in the published app -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <!-- Package -->
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
