<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Package -->
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tagcode/Uniform.Chat</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tagcode/Uniform.Chat</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>LiveKit access tokens and their grants, and the MatrixRTC authorization service's messages, room names and participant identities, as Element Call and lk-jwt-service use them.</Description>
    <PackageTags>livekit;matrixrtc;matrix;jwt;webrtc</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Readme shown on nuget.org -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>

  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Uniform.LiveKit.Tests" />
  </ItemGroup>

</Project>
