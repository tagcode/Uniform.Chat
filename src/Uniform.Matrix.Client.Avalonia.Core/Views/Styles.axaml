<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Text -->
  <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.subtitle"><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.hint"><Setter Property="FontSize" Value="12" /><Setter Property="Opacity" Value="0.65" /></Style>
  <Style Selector="TextBlock.error"><Setter Property="Foreground" Value="#E5484D" /></Style>
  <Style Selector="TextBlock.unread"><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.sender"><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.time"><Setter Property="FontSize" Value="11" /><Setter Property="Opacity" Value="0.55" /></Style>
  <Style Selector="Run.time"><Setter Property="FontSize" Value="11" /></Style>
  <Style Selector="TextBlock.info"><Setter Property="FontSize" Value="12" /><Setter Property="Opacity" Value="0.65" /><Setter Property="FontStyle" Value="Italic" /><Setter Property="Margin" Value="0,4" /></Style>
  <Style Selector="TextBlock.typing"><Setter Property="FontSize" Value="12" /><Setter Property="Opacity" Value="0.65" /><Setter Property="Margin" Value="14,0,14,0" /></Style>
  <Style Selector="TextBlock.status"><Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="12,6" /><Setter Property="Opacity" Value="0.8" /></Style>
  <Style Selector="SelectableTextBlock.highlight"><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="SelectableTextBlock.pending"><Setter Property="Opacity" Value="0.6" /></Style>

  <!-- Panels -->
  <Style Selector="Border.sidebar">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="Border.header">
    <Setter Property="Padding" Value="8,8" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.banner">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAccentBrush}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Border.call">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Background" Value="#1B5E3A" />
    <Setter Property="TextElement.Foreground" Value="White" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="#C62828" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#E53935" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Border.notice">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}" />
  </Style>
  <Style Selector="Border.overlay">
    <Setter Property="Background" Value="#80000000" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="MaxWidth" Value="480" />
    <Setter Property="Margin" Value="16" />
    <Setter Property="Padding" Value="20,12,20,20" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
  </Style>
  <!-- Cards with lists use the whole height, e.g. on phones -->
  <Style Selector="Border.card.tall">
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.compose">
    <Setter Property="Margin" Value="12,6,12,0" />
    <Setter Property="Padding" Value="10,2,2,2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}" />
  </Style>
  <Style Selector="Border.quote">
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>
  <Style Selector="Border.reactions">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,1" />
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}" />
  </Style>

  <!-- Room list -->
  <Style Selector="Border.avatar">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.avatar.small">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>
  <Style Selector="Border.avatar TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="MinWidth" Value="22" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
  </Style>
  <Style Selector="Border.badge.mention"><Setter Property="Background" Value="#E5484D" /></Style>
  <Style Selector="Border.badge > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="ListBox.rooms"><Setter Property="Background" Value="Transparent" /></Style>

  <!-- Messages: no selection highlight -->
  <Style Selector="ListBox.messages"><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="8,0" /></Style>
  <Style Selector="ListBox.messages ListBoxItem"><Setter Property="Padding" Value="8,0" /></Style>
  <Style Selector="ListBox.messages ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="ListBox.messages ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" /></Style>

  <!-- Buttons with a symbol -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <!-- Icon buttons big enough to touch -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
</Styles>
