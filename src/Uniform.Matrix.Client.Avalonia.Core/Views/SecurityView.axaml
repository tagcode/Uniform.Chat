<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Uniform.Matrix.Client.Avalonia.Core.ViewModels"
             x:Class="Uniform.Matrix.Client.Avalonia.Core.Views.SecurityView"
             x:DataType="vm:SecurityViewModel">
  <StackPanel Spacing="10">
    <TextBlock Classes="title" Text="Security" />
    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />

    <!-- Status -->
    <ItemsControl ItemsSource="{Binding Lines}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:StatusLine">
          <Grid ColumnDefinitions="120,*" Margin="0,2">
            <TextBlock Grid.Column="0" Classes="hint" Text="{Binding Label}" VerticalAlignment="Top" />
            <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- New recovery key, shown once -->
    <Border Classes="notice" IsVisible="{Binding HasNewRecoveryKey}">
      <StackPanel Spacing="6">
        <TextBlock Classes="subtitle" Text="Your recovery key" />
        <TextBlock TextWrapping="Wrap" Text="Write it down or copy it somewhere safe now; it is not shown again. With it, a new sign-in can verify itself and read old messages." />
        <SelectableTextBlock Text="{Binding NewRecoveryKey}" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" TextWrapping="Wrap" />
        <Button Content="Copy" Click="OnCopyClick" HorizontalAlignment="Right" />
      </StackPanel>
    </Border>

    <!-- Set up -->
    <StackPanel Spacing="6" IsVisible="{Binding CanSetUp}">
      <TextBlock Classes="subtitle" Text="Set up recovery" />
      <TextBlock Classes="hint" TextWrapping="Wrap" Text="Create cross-signing keys, a key backup of message keys, and a recovery key." />
      <TextBox Classes="revealPasswordButton" Text="{Binding Password}" PasswordChar="•" PlaceholderText="Account password" IsVisible="{Binding NeedsPassword}" />
      <Button Classes="accent" Content="Set up" Command="{Binding SetUpCommand}" HorizontalAlignment="Right" />
    </StackPanel>

    <!-- Recover -->
    <StackPanel Spacing="6" IsVisible="{Binding CanRecover}">
      <TextBlock Classes="subtitle" Text="Unlock encrypted history" />
      <TextBlock Classes="hint" TextWrapping="Wrap" Text="Enter the recovery key or passphrase you set up in this or another app, such as Element." />
      <TextBox Classes="revealPasswordButton" Text="{Binding RecoveryInput}" PlaceholderText="EsT…" PasswordChar="•" />
      <Button Classes="accent" Content="Recover" Command="{Binding RecoverCommand}" HorizontalAlignment="Right" />
    </StackPanel>

    <!-- Verify -->
    <StackPanel Spacing="6" IsVisible="{Binding CanVerify}">
      <TextBlock Classes="subtitle" Text="Verify with another device" />
      <TextBlock Classes="hint" TextWrapping="Wrap" Text="Compare emoji with another device where you are signed in, such as Element on your phone." />
      <Button Content="Verify" Command="{Binding VerifyCommand}" HorizontalAlignment="Right" />
    </StackPanel>

    <!-- Devices -->
    <TextBlock Classes="subtitle" Text="Devices" IsVisible="{Binding HasDevices}" />
    <ItemsControl ItemsSource="{Binding Devices}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:DeviceItem">
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="hint" Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1" Classes="link" Margin="8,0,0,0" Content="Verify" Click="OnVerifyDeviceClick" IsVisible="{Binding CanVerify}" />
            <Button Grid.Column="2" Classes="link" Margin="8,0,0,0" Content="Sign out…" Click="OnSignOutDeviceClick" IsVisible="{Binding CanSignOut}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Signing out another device -->
    <Border Classes="notice" IsVisible="{Binding IsSigningOutDevice}">
      <StackPanel Spacing="6">
        <TextBlock TextWrapping="Wrap" Text="{Binding SigningOut.Name, StringFormat='Sign out {0}? Enter your account password to confirm.', FallbackValue=''}" />
        <TextBox Classes="revealPasswordButton" Text="{Binding Password}" PasswordChar="•" PlaceholderText="Account password" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Classes="accent" Content="Sign out" Command="{Binding ConfirmSignOutCommand}" />
          <Button Content="Cancel" Command="{Binding CancelSignOutCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Blocked users -->
    <StackPanel Spacing="4" IsVisible="{Binding HasBlockedUsers}">
      <TextBlock Classes="subtitle" Text="Blocked users" />
      <TextBlock Classes="hint" TextWrapping="Wrap" Text="Their messages and invites do not show." />
      <ItemsControl ItemsSource="{Binding BlockedUsers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
              <TextBlock Grid.Column="0" Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="link" Margin="8,0,0,0" Content="Unblock" Tag="{Binding}" Click="OnUnblockClick" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Deleting the account -->
    <StackPanel Spacing="6">
      <TextBlock Classes="subtitle" Text="Account" />
      <Button Classes="danger" Content="Delete account…" Command="{Binding StartDeleteAccountCommand}" HorizontalAlignment="Left" IsVisible="{Binding !IsDeletingAccount}" />
      <Border Classes="notice" IsVisible="{Binding IsDeletingAccount}">
        <StackPanel Spacing="6">
          <TextBlock TextWrapping="Wrap" Text="Delete the account for good? You leave every room, your name and picture are removed, and every device is signed out. The user ID cannot be used again. Enter your password to confirm." />
          <TextBox x:Name="DeletePasswordBox" Classes="revealPasswordButton" Text="{Binding Password}" PasswordChar="•" PlaceholderText="Account password" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="danger" Content="Delete account" Command="{Binding ConfirmDeleteAccountCommand}" />
            <Button Content="Cancel" Command="{Binding CancelDeleteAccountCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>
</UserControl>
