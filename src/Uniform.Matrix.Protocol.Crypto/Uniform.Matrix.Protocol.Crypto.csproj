<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Package -->
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <PackageLicenseExpression>MIT AND Apache-2.0</PackageLicenseExpression>
    <Description>Matrix end-to-end encryption in pure .NET: Olm, Megolm, cross-signing, secret storage, key backup and emoji verification, ported from vodozemac and compatible with it.</Description>
    <PackageTags>matrix;e2ee;olm;megolm;encryption</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Attribution of the vodozemac port, inside the package -->
  <ItemGroup>
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSES\Apache-2.0.txt" Pack="true" PackagePath="LICENSES\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Uniform.Matrix.Protocol.Core\Uniform.Matrix.Protocol.Core.csproj" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Uniform.Matrix.Protocol.Crypto.Tests" />
  </ItemGroup>

</Project>
