<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Package -->
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tagcode/Uniform.Chat</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tagcode/Uniform.Chat</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>A LiveKit client in pure C#: signalling, publishing and subscribing over WebRTC, and the end-to-end encryption of frames; and clients of LiveKit's room service and of a MatrixRTC authorization service (lk-jwt-service), which exchanges a Matrix OpenID token for a LiveKit access token.</Description>
    <PackageTags>livekit;matrixrtc;matrix;webrtc</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Readme shown on nuget.org -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <ProjectReference Include="..\Uniform.LiveKit.Protocol\Uniform.LiveKit.Protocol.csproj" />
    <ProjectReference Include="..\Uniform.Matrix.WebRtc\Uniform.Matrix.WebRtc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Uniform.LiveKit.Tests" />
  </ItemGroup>

</Project>
