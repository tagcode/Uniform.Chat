{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../../src",
          "files": [ "Uniform.*/*.csproj" ],
          "exclude": [ "Uniform.Matrix.Client.Android/*.csproj" ]
        }
      ],
      "dest": "api",
      "namespaceLayout": "flattened",
      "enumSortOrder": "declaringOrder"
    }
  ],
  "build": {
    "content": [
      { "files": [ "**/*.{md,yml}" ], "exclude": [ "_site/**", "theme/**" ] }
    ],
    "output": "_site",
    "template": [ "statictoc", "../theme" ],
    "globalMetadata": {
      "_appFooter": "<span></span>",
      "_appTitle": "Matrix .NET Developer Guide",
      "_appName": "Matrix .NET",
      "_enableSearch": true
    }
  }
}
