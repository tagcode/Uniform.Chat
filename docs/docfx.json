{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [ "Uniform.*/*.csproj" ],
          "exclude": [ "Uniform.Chat.Android/*.csproj" ]
        }
      ],
      "dest": "api",
      "namespaceLayout": "flattened",
      "enumSortOrder": "declaringOrder"
    }
  ],
  "build": {
    "content": [
      { "files": [ "**/*.{md,yml}" ], "exclude": [ "_site/**" ] }
    ],
    "output": "_site",
    "xref": [ "https://learn.microsoft.com/en-us/dotnet/.xrefmap.json" ],
    "template": [ "statictoc", "../theme" ],
    "globalMetadata": {
      "_appFooter": "<span>Uniform Chat</span>",
      "_appTitle": "Uniform Chat Developer Guide",
      "_appName": "Uniform Chat",
      "_enableSearch": true
    }
  }
}
