{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      { "files": [ "**/*.{md,yml}" ], "exclude": [ "_site/**" ] }
    ],
    "resource": [
      { "files": [ "images/**" ] }
    ],
    "output": "_site",
    "template": [ "../theme" ],
    "globalMetadata": {
      "_appTitle": "Uniform.Matrix Client Guide",
      "_appName": "Uniform.Matrix Client",
      "_enableSearch": true
    }
  }
}
