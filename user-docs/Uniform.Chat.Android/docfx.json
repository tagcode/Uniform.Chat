{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "statictoc",
      "../../theme"
    ],
    "globalMetadata": {
      "_appFooter": "<span>Uniform Chat for Android</span>",
      "_appTitle": "Uniform Chat for Android",
      "_appName": "Uniform Chat for Android",
      "_enableSearch": true
    }
  }
}
