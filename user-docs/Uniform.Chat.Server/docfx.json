{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      { "files": [ "**/*.{md,yml}" ], "exclude": [ "_site/**" ] }
    ],
    "output": "_site",
    "template": [ "statictoc", "../../theme" ],
    "globalMetadata": {
      "_appFooter": "<span>Uniform.Matrix.Server.Host</span>",
      "_appTitle": "Uniform.Matrix.Server.Host",
      "_appName": "Uniform.Matrix.Server.Host",
      "_enableSearch": true
    }
  }
}
