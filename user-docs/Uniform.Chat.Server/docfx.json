{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      { "files": [ "**/*.{md,yml}" ], "exclude": [ "_site/**" ] }
    ],
    "output": "_site",
    "template": [ "statictoc", "../../theme" ],
    "globalMetadata": {
      "_appFooter": "<span>Uniform Chat Server</span>",
      "_appTitle": "Uniform Chat Server",
      "_appName": "Uniform Chat Server",
      "_enableSearch": true
    }
  }
}
