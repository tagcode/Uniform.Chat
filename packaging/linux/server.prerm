#!/bin/sh
# Before removing uniform-chat-server: stop and disable the service, so the program is not removed under it.
# An update leaves it running; the new version's postinst restarts it.
set -e

if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
    systemctl stop uniform-chat-server.service || true
    systemctl disable uniform-chat-server.service || true
fi

exit 0
