<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Package -->
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- Avalonia.Headless.XUnit 12 is built against xUnit v3 3.2; 4.0 changed its extension API -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Uniform.Chat.Avalonia\Uniform.Chat.Avalonia.csproj" />
    <ProjectReference Include="..\..\src\Uniform.Matrix.Server\Uniform.Matrix.Server.csproj" />
  </ItemGroup>

  <!-- Checks of translations, shared by the test projects of projects with texts -->
  <ItemGroup>
    <Compile Include="..\Shared\LocalizationChecks.cs" Link="LocalizationChecks.cs" />
    <Compile Include="..\Shared\ExifJpeg.cs" Link="ExifJpeg.cs" />
    <Compile Include="..\Shared\TestPhotos.cs" Link="TestPhotos.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\Uniform.Matrix.Audio.Tests\Resources\tone_voice_mono.ogg" Link="Resources\tone_voice_mono.ogg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Uniform.Matrix.Video.Tests\Resources\*.webm" LinkBase="Resources" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
